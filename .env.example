# Copy this file to .env and fill in the values. Never commit .env.

# Web server (keep HOST at 127.0.0.1 so only this computer can open the dashboard)
HOST=127.0.0.1
PORT=3000

# PostgreSQL connection, e.g. postgres://USER:PASSWORD@localhost:5432/spending
DATABASE_URL=

# Mailbox that receives the BCA notification emails.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
# Gmail tip: use "[Gmail]/All Mail" if a filter skips the inbox for BCA emails.
IMAP_MAILBOX=INBOX

# Sender domains or addresses treated as BCA (comma-separated)
BCA_SENDERS=bca.co.id

# How often to check for new emails, and how far back to look on the first run
SYNC_INTERVAL_SECONDS=60
INITIAL_SYNC_DAYS=90

# true = drop emails whose DKIM signature from the sender domain did not pass
# (protects against spoofed "BCA" emails; needs a provider that adds Authentication-Results, e.g. Gmail)
REQUIRE_DKIM=false

# Time zone used for daily/monthly totals
TIMEZONE=Asia/Jakarta

# Sign in with Google (OAuth client from https://console.cloud.google.com/apis/credentials).
# When set, the dashboard asks for Google sign-in and only lets in ALLOWED_EMAILS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=

# Optional HTTPS address for opening the dashboard on your phone, e.g. https://my-pc.your-tailnet.ts.net
# (from "tailscale serve"). Requires Google sign-in.
PUBLIC_URL=

# Optional: AI analysis on the Forecast page, with an API key from https://platform.deepseek.com/api_keys
# Only monthly totals per category and merchant names are sent to DeepSeek, never account numbers or email text.
# Without a key the page still shows the statistical forecast.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
